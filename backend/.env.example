# Copy this file to backend/.env and set credentials for your local PostgreSQL.
PORT=3001
JWT_KEY=replace-with-a-long-random-local-key

# Development database
DEV_DB_USERNAME=postgres
DEV_DB_PASSWORD=postgres
DEV_DB_NAME=conduit_collections_dev
DEV_DB_HOSTNAME=127.0.0.1
DEV_DB_DIALECT=postgres

# Separate database for automated tests and browser E2E
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=postgres
TEST_DB_NAME=conduit_collections_test
TEST_DB_HOSTNAME=127.0.0.1
TEST_DB_DIALECT=postgres

# Production values are examples; configure these in the deployment environment.
PROD_DB_USERNAME=postgres
PROD_DB_PASSWORD=replace-in-production
PROD_DB_NAME=conduit_collections_prod
PROD_DB_HOSTNAME=127.0.0.1
PROD_DB_DIALECT=postgres
